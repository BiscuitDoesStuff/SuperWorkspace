# Generated by SuperWorkspace from its hard limits; sw update rewrites this file.
# Put project-owned rules in another .rules file. Codex loads project rules only
# when it trusts this project, and rules are experimental.
# Prefix rules match literal leading words only. Not matched: options or runner
# prefixes before them (git -C <dir> push, rtk git push, env, cmd /c), a
# path-qualified or differently cased program (/usr/bin/git, Git), remotes
# other than origin, upstream and personal, a branch before the force or rebase
# flag (git push origin <branch> --force), an argument before the amend flag
# (git commit -m <msg> --amend), a reset to an unlisted commit (a SHA, another
# branch or tag), --force-with-lease=<ref>, a <src>:main refspec other than
# HEAD:main, +refspecs other than +HEAD and +main, an abbreviated long option
# (git commit --amen), Git aliases and configuration, and a bare git push while
# main is checked out. A shell-wrapped command meets these rules only when
# Codex parses it as plain words; an unquoted word with ~ ^ { } * ? [ ] $
# or a backtick (git reset --hard HEAD~1) leaves it unchecked (openai/codex
# source, not verified live). .sw/workspace.md lists the known gaps.
# Guardrails, not a sandbox.

prefix_rule(
    pattern = [["git", "git.exe"], "push", ["--force", "-f", "--force-with-lease", "--force-if-includes", "-uf", "-fu", "-vf", "-fv", "-qf", "-fq", "-nf", "-fn", "-df", "-fd"]],
    decision = "forbidden",
    justification = "Hard limit: no force-push. Hand the owner the exact command.",
    match = ["git push --force"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "push", ["origin", "upstream", "personal"], ["--force", "-f", "--force-with-lease", "--force-if-includes", "-uf", "-fu", "-vf", "-fv", "-qf", "-fq", "-nf", "-fn", "-df", "-fd"]],
    decision = "forbidden",
    justification = "Hard limit: no force-push. Hand the owner the exact command.",
    match = ["git push origin --force"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "push", ["origin", "upstream", "personal"], "+HEAD"],
    decision = "forbidden",
    justification = "Hard limit: no force-push. Hand the owner the exact command.",
    match = ["git push origin +HEAD"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "push", ["origin", "upstream", "personal"], ["main", "HEAD:main", "refs/heads/main", "HEAD:refs/heads/main", ":main", "+main", "+HEAD:main"]],
    decision = "forbidden",
    justification = "Hard limit: no push to main. Publish through a t3/ branch and a pull request.",
    match = ["git push origin main"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "push", ["-u", "--set-upstream"], ["origin", "upstream", "personal"], ["main", "HEAD:main", "refs/heads/main", "HEAD:refs/heads/main", ":main", "+main", "+HEAD:main"]],
    decision = "forbidden",
    justification = "Hard limit: no push to main. Publish through a t3/ branch and a pull request.",
    match = ["git push -u origin main"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "push", ["--all", "--mirror"]],
    decision = "forbidden",
    justification = "Hard limit: no push to main. Publish through a t3/ branch and a pull request.",
    match = ["git push --all"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "push", ["origin", "upstream", "personal"], ["--all", "--mirror"]],
    decision = "forbidden",
    justification = "Hard limit: no push to main. Publish through a t3/ branch and a pull request.",
    match = ["git push origin --all"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "push", ["--delete", "-d"], ["origin", "upstream", "personal"], "main"],
    decision = "forbidden",
    justification = "Hard limit: no push to main. Publish through a t3/ branch and a pull request.",
    match = ["git push --delete origin main"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "push", ["origin", "upstream", "personal"], ["--delete", "-d"], "main"],
    decision = "forbidden",
    justification = "Hard limit: no push to main. Publish through a t3/ branch and a pull request.",
    match = ["git push origin --delete main"],
)

prefix_rule(
    pattern = [["gh", "gh.exe"], "release", ["create", "edit", "delete", "delete-asset", "upload"]],
    decision = "forbidden",
    justification = "Hard limit: no gh release writes. Releases belong to the owner.",
    match = ["gh release create"],
)

prefix_rule(
    pattern = [["gh", "gh.exe"], "repo", ["edit", "delete", "rename", "archive"]],
    decision = "forbidden",
    justification = "Hard limit: no repository-setting changes. Settings belong to the owner.",
    match = ["gh repo edit"],
)

prefix_rule(
    pattern = [["gh", "gh.exe"], ["ruleset", "secret", "variable"]],
    decision = "forbidden",
    justification = "Hard limit: no repository-setting changes. Settings belong to the owner.",
    match = ["gh ruleset"],
)

prefix_rule(
    pattern = [["git", "git.exe"], ["filter-branch", "filter-repo"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite main history.",
    match = ["git filter-branch"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "update-ref", ["main", "refs/heads/main"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite main history.",
    match = ["git update-ref main"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "update-ref", "-d", ["main", "refs/heads/main"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite main history.",
    match = ["git update-ref -d main"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "branch", ["-f", "--force", "-D", "-M", "-C"], "main"],
    decision = "forbidden",
    justification = "Hard limit: never rewrite main history.",
    match = ["git branch -f main"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "branch", ["-q", "--quiet"], ["-f", "--force", "-D", "-M", "-C"], "main"],
    decision = "forbidden",
    justification = "Hard limit: never rewrite main history.",
    match = ["git branch -q -f main"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "branch", "main", ["-f", "--force"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite main history.",
    match = ["git branch main -f"],
)

prefix_rule(
    pattern = [["git", "git.exe"], ["checkout", "switch"], ["-B", "-fB", "-C", "--force-create"], "main"],
    decision = "forbidden",
    justification = "Hard limit: never rewrite main history.",
    match = ["git checkout -B main"],
)

prefix_rule(
    pattern = [["git", "git.exe"], ["checkout", "switch"], ["-f", "--force", "-q", "--quiet", "--discard-changes"], ["-B", "-C", "--force-create"], "main"],
    decision = "forbidden",
    justification = "Hard limit: never rewrite main history.",
    match = ["git checkout -f -B main"],
)

prefix_rule(
    pattern = [["git", "git.exe"], ["checkout", "switch"], ["-Bmain", "-fBmain", "-Cmain", "--force-create=main"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite main history.",
    match = ["git checkout -Bmain"],
)

prefix_rule(
    pattern = [["git", "git.exe"], ["checkout", "switch"], ["-f", "--force", "-q", "--quiet", "--discard-changes"], ["-Bmain", "-Cmain", "--force-create=main"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite main history.",
    match = ["git checkout -f -Bmain"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "reset", ["--hard", "--soft", "--mixed", "--merge", "--keep"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite or discard history. Make a new commit, merge instead of rebasing (git pull --no-rebase, git merge main), and unstage with git restore --staged.",
    match = ["git reset --hard"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "reset", ["-q", "--quiet"], ["--hard", "--soft", "--mixed", "--merge", "--keep"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite or discard history. Make a new commit, merge instead of rebasing (git pull --no-rebase, git merge main), and unstage with git restore --staged.",
    match = ["git reset -q --hard"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "reset", ["HEAD~", "HEAD~1", "HEAD~2", "HEAD~3", "HEAD~4", "HEAD~5", "HEAD^", "HEAD^^", "HEAD^1", "HEAD^2", "@~", "@~1", "@~2", "@~3", "@^", "@{u}", "@{upstream}", "@{1}", "HEAD@{1}", "ORIG_HEAD", "FETCH_HEAD", "MERGE_HEAD", "CHERRY_PICK_HEAD", "REBASE_HEAD", "REVERT_HEAD", "main", "origin/main", "upstream/main", "personal/main", "refs/heads/main"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite or discard history. Make a new commit, merge instead of rebasing (git pull --no-rebase, git merge main), and unstage with git restore --staged.",
    match = ["git reset HEAD~"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "reset", ["-q", "--quiet", "-N", "--end-of-options"], ["HEAD~", "HEAD~1", "HEAD~2", "HEAD~3", "HEAD~4", "HEAD~5", "HEAD^", "HEAD^^", "HEAD^1", "HEAD^2", "@~", "@~1", "@~2", "@~3", "@^", "@{u}", "@{upstream}", "@{1}", "HEAD@{1}", "ORIG_HEAD", "FETCH_HEAD", "MERGE_HEAD", "CHERRY_PICK_HEAD", "REBASE_HEAD", "REVERT_HEAD", "main", "origin/main", "upstream/main", "personal/main", "refs/heads/main"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite or discard history. Make a new commit, merge instead of rebasing (git pull --no-rebase, git merge main), and unstage with git restore --staged.",
    match = ["git reset -q HEAD~"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "commit", "--amend"],
    decision = "forbidden",
    justification = "Hard limit: never rewrite or discard history. Make a new commit, merge instead of rebasing (git pull --no-rebase, git merge main), and unstage with git restore --staged.",
    match = ["git commit --amend"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "commit", ["-a", "--all", "--no-edit", "--no-verify", "-q", "--quiet"], "--amend"],
    decision = "forbidden",
    justification = "Hard limit: never rewrite or discard history. Make a new commit, merge instead of rebasing (git pull --no-rebase, git merge main), and unstage with git restore --staged.",
    match = ["git commit -a --amend"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "rebase"],
    decision = "forbidden",
    justification = "Hard limit: never rewrite or discard history. Make a new commit, merge instead of rebasing (git pull --no-rebase, git merge main), and unstage with git restore --staged.",
    match = ["git rebase"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "pull", ["--rebase", "-r", "-vr", "-qr", "-rv", "-rq", "--rebase=true", "--rebase=merges", "--rebase=interactive", "--rebase=i", "--rebase=m", "--rebase=yes", "--rebase=on", "--rebase=1"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite or discard history. Make a new commit, merge instead of rebasing (git pull --no-rebase, git merge main), and unstage with git restore --staged.",
    match = ["git pull --rebase"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "pull", ["origin", "upstream", "personal"], ["--rebase", "-r", "-vr", "-qr", "-rv", "-rq", "--rebase=true", "--rebase=merges", "--rebase=interactive", "--rebase=i", "--rebase=m", "--rebase=yes", "--rebase=on", "--rebase=1"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite or discard history. Make a new commit, merge instead of rebasing (git pull --no-rebase, git merge main), and unstage with git restore --staged.",
    match = ["git pull origin --rebase"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "pull", ["origin", "upstream", "personal"], "main", ["--rebase", "-r", "-vr", "-qr", "-rv", "-rq", "--rebase=true", "--rebase=merges", "--rebase=interactive", "--rebase=i", "--rebase=m", "--rebase=yes", "--rebase=on", "--rebase=1"]],
    decision = "forbidden",
    justification = "Hard limit: never rewrite or discard history. Make a new commit, merge instead of rebasing (git pull --no-rebase, git merge main), and unstage with git restore --staged.",
    match = ["git pull origin main --rebase"],
)
